# Ambiente virtual
.venv/
.venv-dev/
venv/
env/

# Claude caso use
.claude/

# Cache Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python

# Variáveis de ambiente (nunca versionar segredos)
.env

# Outputs gerados em runtime
outputs/plots/*.png
outputs/plots/*.jpg
outputs/models/*.pkl
outputs/models/*.json
# Runs versionados de treino (qtables + histórico + meta por run)
outputs/runs/

# Jupyter
.ipynb_checkpoints/
*.ipynb_checkpoints

# Dados (arquivo grande — use Git LFS ou distribua separadamente)
*.xlsx
*.xls
*.csv

# IDEs
.vscode/
.idea/
*.swp
*.swo

# Sistema operacional
.DS_Store
Thumbs.db
desktop.ini

# Distribuição / build
dist/
build/
*.egg-info/
.eggs/

# pytest
.pytest_cache/
.hypothesis/
.ruff_cache/
.coverage
/.coverage-piloto.json
htmlcov/

# Integracoes locais: podem conter caminhos de maquina ou credenciais.
/.mcp.json
/.codex/config.toml
/.agent-kit/

# Pastas originais dos dois repos, mantidas so ate a validacao da juncao
/Smart_Energy/
/mcp-smartenergy/

# Graphify: compartilhar somente o mapa e o relatorio revisados.
# Caminhos de maquina, cache, custos, logs e memoria de consultas ficam locais.
/graphify-out/*
!/graphify-out/graph.json
!/graphify-out/GRAPH_REPORT.md
!/graphify-out/graph.html
!/graphify-out/manifest.json
